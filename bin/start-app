#!/bin/bash -e

# TEMPORARY Cloud diagnostics probe v3 (names only, never values). Reverted once
# the readiness mechanism is identified. See CLOUD.md.
(
  sleep 5
  for f in /opt/cloud/*/cloud-init-* /opt/cloud/cloud-init-*; do
    [ -f "$f" ] || continue
    case "$f" in *.env*) continue;; esac
    echo "PROBE3 stackfile: $f"
    sed "s|^|PROBE3 stack: |" "$f" || true
  done
  ruby -e 'ENV.keys.sort.each_slice(6){|s| puts "PROBE3 env: #{s.join(" ")}"}'
  echo "PROBE3 ports: PORT=${PORT-unset} HTTP_PORT=${HTTP_PORT-unset} TARGET_PORT=${TARGET_PORT-unset}"
) &

rm -f tmp/pids/server.pid
./bin/rails db:prepare
./bin/rails server
